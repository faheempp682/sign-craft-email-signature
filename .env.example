# Copy to .env.local and fill in. .env.local is gitignored; never commit a real key.
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Model plan (cost-aware). Override only if needed:
#   design   -> Sonnet (quality matters most). Set claude-haiku-5-5 to cut cost.
#   vision   -> Haiku  (screenshot reading). Set claude-sonnet-5-5 for harder images.
#   autofill -> Haiku  (cheap extraction)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_VISION_MODEL=claude-haiku-5-5
# OPENAI_API_KEY is not used yet; reserved for future image generation.

# --- Supabase (auth + saved signatures) ---
# Project Settings > API. Both values are public (safe in the browser); row-level security protects the data.
# Run supabase/migrations/0001_init.sql in the SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional sign-up allowlist (comma-separated). Empty = anyone can sign up.
# ALLOWED_EMAIL_DOMAINS=kimp.xyz

# --- Bunny CDN (image uploads) ---
# Storage > your storage zone > FTP & API Access. SERVER-ONLY: never prefix these with NEXT_PUBLIC_.
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_ACCESS_KEY=your-storage-zone-password
# Your pull zone's public URL, connected to the storage zone (no trailing slash).
BUNNY_CDN_URL=https://your-pullzone.b-cdn.net
# Only if the zone is not in the default Falkenstein region: ny.storage.bunnycdn.com, la.storage.bunnycdn.com, sg.storage.bunnycdn.com, ...
# BUNNY_STORAGE_HOST=storage.bunnycdn.com

# --- AI autofill (text / website -> contact details) ---
# Extraction is a cheap structured task, so it defaults to Haiku and does NOT follow ANTHROPIC_MODEL.
# ANTHROPIC_AUTOFILL_MODEL=claude-haiku-5-5
# Only used when Supabase is NOT configured (local draft mode). With Supabase, limits are set on /admin/limits.
# AUTOFILL_DAILY_LIMIT=60

# --- Access control (Phase 2) ---
# Comma-separated emails that become admins on sign-in. Set it in .env.local, not here.
# ADMIN_EMAILS=you@example.com
# Server-only (Project Settings > API > service_role). NEVER prefix with NEXT_PUBLIC_. Used only to promote ADMIN_EMAILS.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Gmail push (docs/gmail-push.md) ---
# From Google Cloud Console > APIs & Services > Credentials (OAuth client, Web application). Server only.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GOOGLE_TOKEN_ENCRYPTION_KEY=
# Only these Workspace domains may connect (comma-separated). Required.
# GOOGLE_WORKSPACE_DOMAINS=yourcompany.com
# Set in production, exactly as registered in Google Cloud. Defaults to this site's /api/google/callback.
# GOOGLE_REDIRECT_URI=https://your-domain/api/google/callback
